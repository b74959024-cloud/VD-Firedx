-- =====================================================
local IsAutoHooking = false
local HookCache = {}

local function ScanHooks()
    HookCache = {}
    local map = Workspace:FindFirstChild("Map"); if not map then return end
    for _, obj in ipairs(map:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == "Hook" then
            local part = obj:FindFirstChild("HitBox", true) or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
            if part then table.insert(HookCache, { model = obj, part = part }) end
        end
    end
end

local function AutoHookKiller()
    if not VD.KILLER_AutoHook or GetRole() ~= "Killer" then return end
    if IsAutoHooking then return end
    local myRoot = GetMyRoot(); if not myRoot then return end
    local char = GetMyChar()
    local carrying = char and (char:GetAttribute("IsCarrying") or char:GetAttribute("isCarrying"))
    if carrying then
        local occupied = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                if p.Character:GetAttribute("IsHooked") or p.Character:GetAttribute("isHooked") then
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then table.insert(occupied, hrp.Position) end
                end
            end
        end
        local closest, cd = nil, math.huge
        for _, h in ipairs(HookCache) do
            if h.part then
                local occ = false
                for _, pos in ipairs(occupied) do
                    if (h.part.Position - pos).Magnitude < 10 then occ = true; break end
                end
                if not occ then
                    local d = (h.part.Position - myRoot.Position).Magnitude
                    if d < cd then cd = d; closest = h end
                end
            end
        end
        if closest then
            IsAutoHooking = true
            task.spawn(function()
                myRoot.CFrame = CFrame.new(closest.part.Position + Vector3.new(0, 3, 0))
                task.wait(0.4)
                pcall(function()
                    local r = ReplicatedStorage:FindFirstChild("Remotes")
                    local c = r and r:FindFirstChild("Carry")
                    local ev = c and c:FindFirstChild("HookEvent")
                    local cm = c and c:FindFirstChild("HookCommit")
                    local hp = closest.model and (closest.model:FindFirstChild("HookPoint") or closest.model:FindFirstChild("HookHitbox"))
                    if not hp then hp = closest.part end
                    if ev then ev:FireServer(hp) end
                    if cm then cm:FireServer(hp) end
                end)
                task.wait(0.5); IsAutoHooking = false
            end)
        end
        return
    end
    local cd, closestDowned = math.huge, nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and IsSurvivorPlayer(p) and p.Character then
            local tr = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if tr and hum and hum.MaxHealth > 0 then
                local pct = hum.Health / hum.MaxHealth
                if pct <= 0.25 and pct > 0 then
                    local d = (tr.Position - myRoot.Position).Magnitude
                    if d < cd then cd = d; closestDowned = tr end
                end
            end
        end
    end
    if not closestDowned then return end
    IsAutoHooking = true
    task.spawn(function()
        myRoot.CFrame = CFrame.new(closestDowned.Position + Vector3.new(0, 3, 0), closestDowned.Position)
        task.wait(0.3)
        pcall(function()
            local r = ReplicatedStorage:FindFirstChild("Remotes")
            local c = r and r:FindFirstChild("Carry")
            local ev = c and c:FindFirstChild("CarrySurvivorEvent")
            if ev then ev:FireServer(closestDowned.Parent) end
        end)
        task.wait(0.8)
        local curCarry = char and (char:GetAttribute("IsCarrying") or char:GetAttribute("isCarrying"))
        if curCarry then
            local closest, chd = nil, math.huge
            for _, h in ipairs(HookCache) do
                if h.part then
                    local d = (h.part.Position - myRoot.Position).Magnitude
                    if d < chd then chd = d; closest = h end
                end
            end
