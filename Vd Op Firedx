local function IsRealAttack(kChar, track)
    local myHRP = GetMyRoot(); local kHRP = kChar:FindFirstChild("HumanoidRootPart")
    if not myHRP or not kHRP then return false end
    local dist = (myHRP.Position - kHRP.Position).Magnitude
    if dist > (VD.ParryDistance or 8) + 3 then return false end
    if not kChar:IsDescendantOf(workspace) then return false end
    local kHum = kChar:FindFirstChildOfClass("Humanoid")
    if not kHum or kHum.Health <= 0 then return false end
    if track.Speed <= 0 or not track.IsPlaying then return false end
    local myFlat = Vector3.new(myHRP.Position.X, 0, myHRP.Position.Z)
    local kFlat = Vector3.new(kHRP.Position.X, 0, kHRP.Position.Z)
    local delta = myFlat - kFlat
    if delta.Magnitude > 0 then
        local kLook = Vector3.new(kHRP.CFrame.LookVector.X, 0, kHRP.CFrame.LookVector.Z).Unit
        if kLook:Dot(delta.Unit) < 0.7 then return false end
    end
    return true
end

