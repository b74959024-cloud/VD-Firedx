local OrigHitbox = {}
local function UpdateHitboxes()
    local function restoreAll()
        for player, os in pairs(OrigHitbox) do
            if player and player.Character then
                local r = player.Character:FindFirstChild("HumanoidRootPart")
                if r then r.Size = os; r.Transparency = 1; r.CanCollide = true end
            end
        end
        OrigHitbox = {}
    end
    if GetRole() ~= "Killer" or not VD.KILLER_HitboxEnabled then restoreAll(); return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and IsSurvivorPlayer(p) and p.Character then
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                if not OrigHitbox[p] then OrigHitbox[p] = r.Size end
                local sz = VD.KILLER_HitboxSize or 15
                r.Size = Vector3.new(sz, sz, sz); r.CanCollide = false; r.Transparency = 0.7
            elseif r and OrigHitbox[p] then
                r.Size = OrigHitbox[p]; r.Transparency = 1; r.CanCollide = true; OrigHitbox[p] = nil
            end
        end
    end
end

local function AutoAttackKiller()
    if not VD.KILLER_AutoAttack or GetRole() ~= "Killer" then return end
    local myRoot = GetMyRoot(); if not myRoot then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and IsSurvivorPlayer(p) and p.Character then
            local tRoot = p.Character:FindFirstChild("HumanoidRootPart")
            local tHum = p.Character:FindFirstChildOfClass("Humanoid")
            if tRoot and tHum and tHum.MaxHealth > 0 then
                local pct = tHum.Health / tHum.MaxHealth
                if pct > 0.25 and (tRoot.Position - myRoot.Position).Magnitude <= (VD.KILLER_AttackRange or 12) then
                    pcall(function()
                        local r = ReplicatedStorage:FindFirstChild("Remotes")
                        local a = r and r:FindFirstChild("Attacks")
                        local b = a and a:FindFirstChild("BasicAttack")
                        if b then b:FireServer(false) end
                    end)
                    break
                end
            end
        end
    end
end

local IsBreakingPallet = false
local function DestroyAllPallets()
    if not VD.KILLER_DestroyPallets or GetRole() ~= "Killer" then return end
    if IsBreakingPallet then return end
    local char = GetMyChar(); local root = GetMyRoot()
    if not char or not root then return end
    local stunned = char:GetAttribute("IsStunned") or char:GetAttribute("isStunned")
    local immobile = char:GetAttribute("Immobile") or char:GetAttribute("immobile")
    local carrying = char:GetAttribute("IsCarrying") or char:GetAttribute("isCarrying")
    if stunned or immobile or carrying then return end
    local cs = game:GetService("CollectionService")
    local pts = cs:GetTagged("PalletPointSlide")
    local nearest, md = nil, 6
    for _, p in ipairs(pts) do
        if p:IsA("BasePart") and not cs:HasTag(p, "doing action") then
            local d = (p.Position - root.Position).Magnitude
            if d < md then md = d; nearest = p end
        end
    end
