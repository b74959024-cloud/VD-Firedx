-- [5] INSTANT HEAL (Self + All)
-- =====================================================
local InstantHealConn = nil
local AutoHealAllConn = nil

local function DoSelfHealTrue()
    local char = LocalPlayer.Character
    if not char then return end
    local healRemote = ReplicatedStorage:FindFirstChild("Remotes")
        and ReplicatedStorage.Remotes:FindFirstChild("Healing")
        and ReplicatedStorage.Remotes.Healing:FindFirstChild("HealEvent")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if healRemote and hrp then
        pcall(function() healRemote:FireServer(hrp, true) end)
    end
end

local function DoSelfHealFalse()
    local char = LocalPlayer.Character
    if not char then return end
    local healRemote = ReplicatedStorage:FindFirstChild("Remotes")
        and ReplicatedStorage.Remotes:FindFirstChild("Healing")
        and ReplicatedStorage.Remotes.Healing:FindFirstChild("HealEvent")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if healRemote and hrp then
        pcall(function() healRemote:FireServer(hrp, false) end)
    end
end

local function DoOthersHealTrue(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return end
    local healRemote = ReplicatedStorage:FindFirstChild("Remotes")
        and ReplicatedStorage.Remotes:FindFirstChild("Healing")
        and ReplicatedStorage.Remotes.Healing:FindFirstChild("HealEvent")
    local hrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if healRemote and hrp then
        pcall(function() healRemote:FireServer(hrp, true) end)
    end
end

local function DoOthersHealFalse(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return end
    local healRemote = ReplicatedStorage:FindFirstChild("Remotes")
        and ReplicatedStorage.Remotes:FindFirstChild("Healing")
        and ReplicatedStorage.Remotes.Healing:FindFirstChild("HealEvent")
    local hrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if healRemote and hrp then
        pcall(function() healRemote:FireServer(hrp, false) end)
    end
end

local function SetInstantHealSelf(v)
    CFG.InstantHealSelf = v
    if v then
        if InstantHealConn then InstantHealConn:Disconnect() end
        local healActive = false
        InstantHealConn = RunService.Heartbeat:Connect(function()
            if not CFG.InstantHealSelf then return end
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not hum then return end
            if hum.Health >= hum.MaxHealth * 0.9 then
                if healActive then healActive = false; DoSelfHealFalse() end
                return
            end
            if healActive then
                local check = char:FindFirstChild("CheckInterractable")
                if check and not check:GetAttribute("isHealing") then healActive = false end
            end
            if not healActive then healActive = true; DoSelfHealTrue() end
        end)
    else
        if InstantHealConn then InstantHealConn:Disconnect(); InstantHealConn = nil end
        pcall(DoSelfHealFalse)
    end
end

local function SetAutoHealAll(v)
    CFG.InstantHealAll = v
    if v then
        if AutoHealAllConn then AutoHealAllConn:Disconnect() end
        local active = {}
        AutoHealAllConn = RunService.Heartbeat:Connect(function()
            if not CFG.InstantHealAll then return end
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 and hum.Health < hum.MaxHealth * 0.9 and hrp then
                        if active[p] then
                            local check = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("CheckInterractable")
                            if check and not check:GetAttribute("isHealing") then active[p] = nil end
                        end
                        if not active[p] then active[p] = true; DoOthersHealTrue(p) end
                    else
                        if active[p] then active[p] = nil; DoOthersHealFalse(p) end
                    end
                else
                    if active[p] then active[p] = nil; pcall(function() DoOthersHealFalse(p) end) end
                end
            end
        end)
    else
        if AutoHealAllConn then AutoHealAllConn:Disconnect(); AutoHealAllConn = nil end
    end
end

