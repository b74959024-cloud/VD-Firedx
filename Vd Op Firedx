local TOFState = { Aiming = false, Laser = nil }
local FlashState = { Active = false, Laser = nil, Part = nil }

local function GetTOFEvent()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local items = remotes and remotes:FindFirstChild("Items")
    local tof = items and items:FindFirstChild("Twist of Fate")
    local fire = tof and tof:FindFirstChild("Fire")
    if fire and fire:IsA("RemoteEvent") then return fire end
    return nil
end

local function GetTOFGun()
    local char = GetMyChar(); if not char then return nil end
    local base = char:FindFirstChild("Twist of Fate", true); if not base then return nil end
    local ra = base:FindFirstChild("Right Arm")
    if ra then
        return ra:FindFirstChild("gun") or ra:FindFirstChild("EmperorGun")
    end
    return base
end

local function GetTOFTarget()
    local gun = GetTOFGun(); local char = GetMyChar()
    if not (gun and char) then return nil, nil, nil, nil end
    local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return nil, nil, nil, nil end
    local myPos = hrp.Position
    local origin = Vector3.new(myPos.X, myPos.Y + 1.5, myPos.Z)
    pcall(function()
        if gun:IsA("BasePart") then origin = gun.Position
        else local bp = gun:FindFirstChildOfClass("BasePart"); if bp then origin = bp.Position end end
    end)

    local mode = VD.TOF_TargetMode or "Killer"
    local targetPart = nil
    if mode == "Killer" then
        local cd = math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and IsKillerPlayer(p) and p.Character then
                local t = p.Character:FindFirstChild("Torso") or p.Character:FindFirstChild("UpperTorso") or p.Character:FindFirstChild("HumanoidRootPart")
                if t then
                    local d = (myPos - t.Position).Magnitude
                    if d < cd then cd = d; targetPart = t end
                end
            end
        end
    elseif mode == "Survivors" then
        local cam = workspace.CurrentCamera; local camLook = cam.CFrame.LookVector; local bestDot = -math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and IsSurvivorPlayer(p) and p.Character then
                local t = p.Character:FindFirstChild("Torso") or p.Character:FindFirstChild("UpperTorso") or p.Character:FindFirstChild("HumanoidRootPart")
                if t then
                    local dir = t.Position - cam.CFrame.Position
                    if dir.Magnitude > 0.1 then
                        local dot = camLook:Dot(dir.Unit)
                        if dot > 0.5 and dot > bestDot then bestDot = dot; targetPart = t end
                    end
                end
            end
        end
    end
    if not targetPart then return nil, nil, nil, nil end
    local dir = (targetPart.Position - origin)
    if dir.Magnitude < 0.1 then return nil, nil, nil, nil end
    return dir.Unit, gun, origin, targetPart.Position
end

local function DoTOFShoot()
    if not VD.TOF_SilentAim then return end
    local dir, gun = GetTOFTarget()
    if not (dir and gun) then return end
    local ev = GetTOFEvent(); if not ev then return end
    pcall(function() ev:FireServer(gun, dir) end)
end

