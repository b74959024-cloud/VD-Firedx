getgenv().VD.Destroy = function()
    if ESP.Folder and ESP.Folder.Parent then ESP.Folder:Destroy() end
    if InstantHealConn then InstantHealConn:Disconnect() end
    if AutoHealAllConn then AutoHealAllConn:Disconnect() end
    if getgenv().KYS_AbyssBypassConn then getgenv().KYS_AbyssBypassConn:Disconnect() end
    if ScreenGui and ScreenGui.Parent then ScreenGui:Destroy() end
    print("🧹 FiredX cleaned up")
end

