local ToFEvent = nil
local function getToFEvent()
    if ToFEvent then return ToFEvent end
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local items = remotes and remotes:FindFirstChild("Items")
    local tof = items and items:FindFirstChild("Twist of Fate")
    local fire = tof and tof:FindFirstChild("Fire")
    if fire and fire:IsA("RemoteEvent") then ToFEvent = fire; return fire end
    return nil
end
local function getToFGun()
    local char = LP.Character
    if not char then return nil end
    local base = char:FindFirstChild("Twist of Fate", true)
    if not base then return nil end
    local ra = base:FindFirstChild("Right Arm")
    if ra then
        local g = ra:FindFirstChild("gun") or ra:FindFirstChild("EmperorGun")
        if g then return g end
    end
    return base
end
local function tofShoot()
    if not VD.TOF_SilentAim then return end
    local gun = getToFGun()
    local char = LP.Character
    if not gun or not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local myPos = hrp.Position
    local origin
    pcall(function() origin = gun:IsA("BasePart") and gun.Position or gun:FindFirstChildOfClass("BasePart").Position end)
    origin = origin or (myPos + Vector3.new(0,1.5,0))
    local targetTorso = nil
    local targetChar = nil
    local mode = VD.TOF_TargetMode or "Killer"
    if mode == "Killer" then
        local closest, cd = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Team and p.Team.Name == "Killer" and p.Character then
                local t = p.Character:FindFirstChild("Torso") or p.Character:FindFirstChild("UpperTorso") or p.Character:FindFirstChild("HumanoidRootPart")
                if t then
                    local d = (myPos - t.Position).Magnitude
                    if d < cd then cd = d; closest = t; targetChar = p.Character end
                end
            end
        end
        targetTorso = closest
    elseif mode == "Survivors" then
        local cam = workspace.CurrentCamera
        local look = cam.CFrame.LookVector
        local best, bd = nil, -math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Team and p.Team.Name == "Survivors" and p.Character then
                local t = p.Character:FindFirstChild("Torso") or p.Character:FindFirstChild("UpperTorso") or p.Character:FindFirstChild("HumanoidRootPart")
                if t then
                    local dir = t.Position - cam.CFrame.Position
                    if dir.Magnitude > 0.1 then
                        local dot = look:Dot(dir.Unit)
                        if dot > 0.5 and dot > bd then bd = dot; best = t; targetChar = p.Character end
                    end
                end
            end
        end
        targetTorso = best
    end
    if not targetTorso then return end
    local targetPos = targetTorso.Position
    local rootPart = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    local vel = rootPart and rootPart.Velocity or Vector3.zero
    local dirRaw = targetPos - origin
    local dist = dirRaw.Magnitude
    if dist < 5 then
        local ev = getToFEvent()
        if ev then pcall(function() ev:FireServer(gun, dirRaw.Unit) end) end
        return
    end
    local timeToHit = dist / 400
    local predPos = targetPos + vel * timeToHit
    for i = 1, 2 do
        local nd = (predPos - origin).Magnitude
        timeToHit = nd / 400
        predPos = targetPos + vel * timeToHit
    end
    local final = predPos - origin
    if final.Magnitude < 0.1 then return end
    local ev = getToFEvent()
    if ev then pcall(function() ev:FireServer(gun, final.Unit) end) end
end
