    stk.Thickness = 1

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -20, 0, 34)
    lbl.Position = UDim2.new(0, 12, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = name .. ": " .. default
    lbl.TextColor3 = Color3.fromRGB(230, 230, 240)
    lbl.TextSize = 13
    lbl.Font = Enum.Font.Gotham
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = frame

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromScale(1, 1)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = frame

    local opened = false
    local optionFrames = {}

    local function closeAll()
        for _, f in ipairs(optionFrames) do f.Visible = false end
        frame.Size = UDim2.new(1, 0, 0, 34)
        opened = false
    end

    btn.MouseButton1Click:Connect(function()
        opened = not opened
        if opened then
            local i = 0
            for _, opt in ipairs(options) do
                if not optionFrames[opt] then
                    local ob = Instance.new("TextButton")
                    ob.Size = UDim2.new(1, 0, 0, 28)
                    ob.Position = UDim2.new(0, 0, 0, 34 + i * 28)
                    ob.BackgroundColor3 = Color3.fromRGB(28, 25, 40)
                    ob.BorderSizePixel = 0
                    ob.Text = opt
                    ob.TextColor3 = Color3.fromRGB(200, 200, 220)
                    ob.TextSize = 12
                    ob.Font = Enum.Font.Gotham
                    ob.Parent = frame
                    optionFrames[opt] = ob
                    ob.MouseButton1Click:Connect(function()
                        lbl.Text = name .. ": " .. opt
                        if callback then pcall(callback, opt) end
                        closeAll()
                    end)
                end
                optionFrames[opt].Visible = true
                i = i + 1
            end
            frame.Size = UDim2.new(1, 0, 0, 34 + #options * 28)
        else
            closeAll()
        end
    end)

    return frame
end

