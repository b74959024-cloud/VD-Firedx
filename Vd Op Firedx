local function flashlightTarget()
    local myChar = LP.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local maxR = VD.FLASH_Range or 120
    local best, bd = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and p.Team and p.Team.Name == "Killer" then
            local part = p.Character:FindFirstChild(VD.FLASH_TargetPart or "Head") or p.Character:FindFirstChild("HumanoidRootPart")
            if part then
                local d = (part.Position - myRoot.Position).Magnitude
                if d <= maxR and d < bd then bd = d; best = part end
            end
        end
    end
    return best
end
RunService.RenderStepped:Connect(function()
    if not VD.FLASH_SilentAim then return end
    local cam = workspace.CurrentCamera
    local tp = flashlightTarget()
    if not cam or not tp then return end
    local target = tp.Position
    local smooth = math.clamp(VD.FLASH_Smooth or 0.35, 0.05, 1)
    pcall(function()
        cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, target), smooth)
    end)
end)

