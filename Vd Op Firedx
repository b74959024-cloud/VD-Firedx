-- [8] SPEAR AIMBOT (Veil)
-- =====================================================
local VeilCfg = { Enabled = false, FOV = 150, Speed = 165, Gravity = workspace.Gravity * 0.5, MaxDist = 200, AutoPredict = false, TargetPart = "Torso", PredictFactor = 1.0 }
local VeilState = { Charging = false, AttackCD = false, LastPos = nil }

local function VeilGetTargetPart(char)
    if VeilCfg.TargetPart == "Head" then return char:FindFirstChild("Head") end
    if VeilCfg.TargetPart == "Root" then return char:FindFirstChild("HumanoidRootPart") end
    return char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
end

local function VeilGetClosest()
    local myRoot = GetMyRoot(); if not myRoot then return nil end
    local cam = workspace.CurrentCamera
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local bestD = VeilCfg.FOV; local best = nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and IsSurvivorPlayer(p) and p.Character then
            local part = VeilGetTargetPart(p.Character)
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and part then
                local d3 = (part.Position - myRoot.Position).Magnitude
                if d3 <= VeilCfg.MaxDist then
                    local sp, on = cam:WorldToViewportPoint(part.Position)
                    if on then
                        local d2 = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if d2 < bestD then bestD = d2; best = { Player = p, Part = part } end
                    end
                end
            end
        end
    end
    return best
end

local function VeilFire()
    if VeilState.AttackCD then return end
    VeilState.AttackCD = true
    task.delay(2, function() VeilState.AttackCD = false end)
    local myChar = GetMyChar()
    local startPart = myChar and (myChar:FindFirstChild("Head") or myChar:FindFirstChild("HumanoidRootPart"))
    if not startPart then return end
    local startPos = startPart.Position
    local target = VeilGetClosest(); local aimDir
    if target and target.Part then
        local tp = target.Part.Position
        local dist = (tp - startPos).Magnitude
        local tth = dist / VeilCfg.Speed
        local gravity = VeilCfg.AutoPredict and math.max(0, dist - 8) or VeilCfg.Gravity
        local drop = 0.5 * gravity * (tth ^ 2)
        local finalPos = tp + Vector3.new(0, drop, 0)
        aimDir = (finalPos - startPos).Unit
    else
        aimDir = workspace.CurrentCamera.CFrame.LookVector
    end
    pcall(function()
        local r = ReplicatedStorage:FindFirstChild("Remotes")
        local k = r and r:FindFirstChild("Killers")
        local v = k and k:FindFirstChild("Veil")
        local s = v and v:FindFirstChild("Spearthrow")
        if s then s:FireServer(aimDir, VeilCfg.Speed, startPos) end
    end)
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if not VeilCfg.Enabled then return end
    local char = GetMyChar()
    if not (char and char:GetAttribute("spearmode") == true) then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        VeilState.Charging = true
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if VeilState.Charging and input.UserInputType == Enum.UserInputType.MouseButton1 then
        VeilState.Charging = false
        VeilFire()
    end
end)

