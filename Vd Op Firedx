local function GetRole()
    local t = LocalPlayer.Team
    if not t then return "Lobby" end
    if t.Name == "Killer" then return "Killer" end
    if t.Name == "Survivors" then return "Survivor" end
    return "Lobby"
end

local function IsKillerPlayer(p) return p and p.Team and p.Team.Name == "Killer" end
local function IsSurvivorPlayer(p) return p and p.Team and p.Team.Name == "Survivors" end
local function IsDowned(char)
    if not char then return true end
    local st = char:GetAttribute("State")
    return st == "Downed" or st == "Dead"
end
local function GetSafeGuiParent()
    if gethui then local ok, h = pcall(gethui); if ok and h then return h end end
    local ok, c = pcall(function() return game:GetService("CoreGui") end)
    if ok and c then return c end
    return PlayerGui
end
local function GetMyChar() return LocalPlayer.Character end
local function GetMyRoot() local c = GetMyChar(); return c and c:FindFirstChild("HumanoidRootPart") end
local function GetMyHum() local c = GetMyChar(); return c and c:FindFirstChildOfClass("Humanoid") end

-- Notif sederhana (bukan WindUI)
local NotifGui = nil
local function Notify(title, content, duration)
    duration = duration or 3
    pcall(function()
        local parent = GetSafeGuiParent()
        if NotifGui and NotifGui.Parent then NotifGui:Destroy() end
        NotifGui = Instance.new("ScreenGui")
        NotifGui.Name = "FiredX_Notif_" .. tick()
        NotifGui.ResetOnSpawn = false
        NotifGui.IgnoreGuiInset = true
        NotifGui.DisplayOrder = 999999
        NotifGui.Parent = parent
        
        local f = Instance.new("Frame")
        f.Size = UDim2.new(0, 280, 0, 60)
        f.Position = UDim2.new(0.5, -140, 0, -70)
        f.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
        f.BorderSizePixel = 0
        f.Parent = NotifGui
        Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)
        
        local stroke = Instance.new("UIStroke", f)
        stroke.Color = Color3.fromRGB(255, 120, 50)
        stroke.Thickness = 1.5
        
        local grad = Instance.new("UIGradient", stroke)
        grad.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 140, 0)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 50, 50)),
        }
        
        local t = Instance.new("TextLabel")
        t.Size = UDim2.new(1, -20, 0, 20)
        t.Position = UDim2.new(0, 10, 0, 6)
        t.BackgroundTransparency = 1
        t.Text = title
        t.TextColor3 = Color3.fromRGB(255, 180, 100)
        t.TextSize = 13
        t.Font = Enum.Font.GothamBold
        t.TextXAlignment = Enum.TextXAlignment.Left
        t.Parent = f
        
        local c = Instance.new("TextLabel")
        c.Size = UDim2.new(1, -20, 0, 28)
        c.Position = UDim2.new(0, 10, 0, 26)
        c.BackgroundTransparency = 1
        c.Text = content
        c.TextColor3 = Color3.fromRGB(230, 230, 240)
        c.TextSize = 12
        c.Font = Enum.Font.Gotham
        c.TextXAlignment = Enum.TextXAlignment.Left
        c.TextWrapped = true
        c.Parent = f
        
        TweenService:Create(f, TweenInfo.new(0.35, Enum.EasingStyle.Back), {
            Position = UDim2.new(0.5, -140, 0, 20),
        }):Play()
        
        task.delay(duration, function()
            TweenService:Create(f, TweenInfo.new(0.35), {
                Position = UDim2.new(0.5, -140, 0, -70),
                BackgroundTransparency = 1,
            }):Play()
            task.wait(0.4)
            if NotifGui then NotifGui:Destroy() end
        end)
    end)
end

