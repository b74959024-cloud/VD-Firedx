    if not CFG.ESP_Nametag and not CFG.ESP_Distance then
        local f = GetESPFolder()
        local t = f:FindFirstChild("Tag_" .. PlayerKey(p))
        if t then t:Destroy() end
        return
    end
    if not head or not head.Parent then return end

    local f = GetESPFolder()
    local name = "Tag_" .. PlayerKey(p)
    local tag = f:FindFirstChild(name)
    if not tag then
        tag = Instance.new("BillboardGui")
        tag.Name = name
        tag.AlwaysOnTop = true
        tag.LightInfluence = 0
        tag.Size = UDim2.new(0, 200, 0, 30)
        tag.StudsOffset = Vector3.new(0, 2.6, 0)
        tag.Parent = f

        local lbl = Instance.new("TextLabel")
        lbl.Name = "Label"
        lbl.BackgroundTransparency = 1
        lbl.Size = UDim2.fromScale(1, 1)
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 13
        lbl.TextStrokeTransparency = 0.5
        lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
        lbl.Parent = tag
    end
    tag.Adornee = head
    tag.Enabled = true

    local lines = {}
    if CFG.ESP_Nametag then table.insert(lines, p.Name) end
    if CFG.ESP_Distance then
        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local tRoot = char and char:FindFirstChild("HumanoidRootPart")
        if myRoot and tRoot then
            table.insert(lines, "[" .. math.floor((myRoot.Position - tRoot.Position).Magnitude) .. "m]")
        end
    end
    local lbl = tag:FindFirstChild("Label")
    if lbl then
        lbl.Text = table.concat(lines, " ")
        lbl.TextColor3 = color
    end
end

local function ApplyPlayerESP(p)
    if p == LocalPlayer then return end
    local char = p.Character
    local f = GetESPFolder()

    if not CFG.ESP_PlayerMaster or not char then
        local h = f:FindFirstChild("P_" .. PlayerKey(p))
        if h then h:Destroy() end
        local t = f:FindFirstChild("Tag_" .. PlayerKey(p))
        if t then t:Destroy() end
        return
    end

    local isKiller = IsKillerPlayer(p)
    local isSurv = IsSurvivorPlayer(p)
    local enabled = (isKiller and CFG.ESP_Killer) or (isSurv and CFG.ESP_Survivor)
    if not enabled then
        local h = f:FindFirstChild("P_" .. PlayerKey(p))
        if h then h:Destroy() end
        local t = f:FindFirstChild("Tag_" .. PlayerKey(p))
        if t then t:Destroy() end
        return
    end

    local color = isKiller and ESP_COLORS.Killer or ESP_COLORS.Survivor
    EnsureHighlight("P_" .. PlayerKey(p), char, color, true)
    local head = char:FindFirstChild("Head")
    UpdatePlayerTag(p, char, head, color)
end

local function RefreshAllPlayers()
    for _, p in ipairs(Players:GetPlayers()) do
        pcall(ApplyPlayerESP, p)
    end
end

local function WatchPlayer(p)
    if p == LocalPlayer then return end
    if ESP.PlayerConns[p] then
        for _, c in ipairs(ESP.PlayerConns[p]) do pcall(function() c:Disconnect() end) end
    end
    ESP.PlayerConns[p] = {}
    table.insert(ESP.PlayerConns[p], p.CharacterAdded:Connect(function() task.delay(0.3, function() pcall(ApplyPlayerESP, p) end) end))
    table.insert(ESP.PlayerConns[p], p:GetPropertyChangedSignal("Team"):Connect(function() pcall(ApplyPlayerESP, p) end))
    pcall(ApplyPlayerESP, p)
end

for _, p in ipairs(Players:GetPlayers()) do WatchPlayer(p) end
Players.PlayerAdded:Connect(WatchPlayer)

-- === Object ESP ===
local function PickObjectPart(model, cat)
    if not model or not model.Parent then return nil end
    if cat == "Generator" then
        return model:FindFirstChild("HitBox", true) or model:FindFirstChild("GeneratorPoint", true) or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
    elseif cat == "Palletwrong" then
        local c = { model:FindFirstChild("HumanoidRootPart", true), model:FindFirstChild("PrimaryPartPallet", true), model:FindFirstChild("PalletPoint", true), model:FindFirstChild("PalletPointSlide", true) }
        for _, pt in ipairs(c) do if pt and pt:IsA("BasePart") then return pt end end
    elseif cat == "Window" then
        return model:FindFirstChild("VaultPoint", true) or model:FindFirstChild("VaultTrigger", true) or model:FindFirstChildWhichIsA("BasePart", true)
    end
    return model:FindFirstChildWhichIsA("BasePart", true)
end

local function RefreshObjectESP()
    local f = GetESPFolder()

    local catsEnabled = {
        Generator = CFG.ESP_ObjectMaster and CFG.ESP_Generator,
        Palletwrong = CFG.ESP_ObjectMaster and CFG.ESP_Pallet,
        Window = CFG.ESP_ObjectMaster and CFG.ESP_Window,
    }

    -- Clear old
    for _, cat in pairs({ "Generator", "Palletwrong", "Window" }) do
        for model in pairs(ESP.ObjectReg[cat]) do
            local h = f:FindFirstChild("O_" .. cat .. "_" .. tostring(model:GetDebugId()))
            if h then h:Destroy() end
        end
        ESP.ObjectReg[cat] = {}
    end

    local map = Workspace:FindFirstChild("Map")
    if not map then return end

    for _, obj in ipairs(map:GetDescendants()) do
        if obj:IsA("Model") and catsEnabled[obj.Name] then
            local cat = obj.Name
            local color = ESP_COLORS[cat]
            local part = PickObjectPart(obj, cat)
            if part then
                local name = "O_" .. cat .. "_" .. tostring(obj:GetDebugId())
                EnsureHighlight(name, obj, color, false)
                ESP.ObjectReg[cat][obj] = true
            end
        end
    end
end

