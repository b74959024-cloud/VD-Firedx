local function Slider(tabName, name, minV, maxV, default, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 48)
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 42)
    frame.BorderSizePixel = 0
    frame.Parent = TabContainers[tabName]
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
    local stk = Instance.new("UIStroke", frame)
    stk.Color = Color3.fromRGB(50, 50, 70)
    stk.Thickness = 1
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -20, 0, 22)
    lbl.Position = UDim2.new(0, 10, 0, 2)
    lbl.BackgroundTransparency = 1
    lbl.Text = name .. ": " .. tostring(default)
    lbl.TextColor3 = Color3.fromRGB(230, 230, 240)
    lbl.TextSize = 12
    lbl.Font = Enum.Font.Gotham
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = frame
    
    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -20, 0, 6)
    bar.Position = UDim2.new(0, 10, 1, -14)
    bar.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
    bar.BorderSizePixel = 0
    bar.Parent = frame
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)
    
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default - minV) / (maxV - minV), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(255, 100, 40)
    fill.BorderSizePixel = 0
    fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    
    local drag = false
    local function updateX(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local v = minV + rel * (maxV - minV)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        lbl.Text = name .. ": " .. string.format("%.2f", v)
        if callback then pcall(callback, v) end
    end
    
    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            drag = true; updateX(i.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            updateX(i.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            drag = false
        end
    end)
    return frame
end

local function Dropdown(tabName, name, options, default, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 34)
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 42)
    frame.BorderSizePixel = 0
    frame.ClipsDescendants = true
    frame.Parent = TabContainers[tabName]
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
    local stk = Instance.new("UIStroke", frame)
    stk.Color = Color3.fromRGB(50, 50, 70)
    stk.Thickness = 1
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -20, 0, 34)
    lbl.Position = UDim2.new(0, 12, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = name .. ": " .. default
    lbl.TextColor3 = Color3.fromRGB(230, 230, 240)
    lbl.TextSize = 13
    lbl.Font = Enum.Font.Gotham
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = frame
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromScale(1, 1)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = frame
    
    local opened = false
    local optFrames = {}
    local function closeAll()
        for _, f in ipairs(optFrames) do f.Visible = false end
        frame.Size = UDim2.new(1, 0, 0, 34)
        opened = false
    end
    
    btn.MouseButton1Click:Connect(function()
        opened = not opened
        if opened then
            local i = 0
            for _, opt in ipairs(options) do
                if not optFrames[opt] then
                    local ob = Instance.new("TextButton")
                    ob.Size = UDim2.new(1, 0, 0, 28)
                    ob.Position = UDim2.new(0, 0, 0, 34 + i * 28)
                    ob.BackgroundColor3 = Color3.fromRGB(24, 24, 32)
                    ob.BorderSizePixel = 0
                                        ob.Text = opt
                    ob.TextColor3 = Color3.fromRGB(200, 200, 220)
                    ob.TextSize = 12
                    ob.Font = Enum.Font.Gotham
                    ob.Parent = frame
                    optFrames[opt] = ob
                    ob.MouseButton1Click:Connect(function()
                        lbl.Text = name .. ": " .. opt
                        if callback then pcall(callback, opt) end
                        closeAll()
                    end)
                end
                optFrames[opt].Visible = true
                i = i + 1
            end
            frame.Size = UDim2.new(1, 0, 0, 34 + #options * 28)
        else
            closeAll()
        end
    end)
    return frame
end

