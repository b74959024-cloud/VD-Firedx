-- Moonwalk
local MWState = { Yaw = nil, Sway = 0, LastEnabled = false }
RunService.Heartbeat:Connect(function(dt)
    local char = GetMyChar(); local hum = GetMyHum(); local root = GetMyRoot()
    if not char or not hum or not root then return end
    if VD.Moonwalk ~= MWState.LastEnabled then
        hum.AutoRotate = not VD.Moonwalk
        MWState.LastEnabled = VD.Moonwalk
        if VD.Moonwalk then
            local _, y = root.CFrame:ToEulerAnglesYXZ()
            MWState.Yaw = math.deg(y)
        end
    end
    if not VD.Moonwalk or hum.Health <= 0 then return end
    hum.AutoRotate = false
    local look = Camera.CFrame.LookVector
    local targetYaw = math.deg(math.atan2(look.X, look.Z)) + 180
    local curr = MWState.Yaw or targetYaw
    local diff = (targetYaw - curr + 180) % 360 - 180
    local lerp = 0.22 * math.clamp((dt or 1/60) * 60, 0, 3)
    curr = curr + diff * lerp; MWState.Yaw = curr
    local moving = hum.MoveDirection.Magnitude > 0.01
    local ts = 0
    if moving then ts = math.sin(tick() * (VD.MoonwalkZigzag or 11)) * 48 end
    MWState.Sway = (MWState.Sway or 0) + (ts - (MWState.Sway or 0)) * 0.38
    root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, math.rad(curr + MWState.Sway), 0)
    if moving then hum:Move(hum.MoveDirection * (VD.MoonwalkBoost or 1.08), false) end
end)

