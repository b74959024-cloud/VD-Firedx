Section("Config", "⚙️ Save / Load")
Button("Config", "Save Config", function()
    pcall(function()
        if writefile then
            writefile("FiredX_VD.json", HttpService:JSONEncode(VD))
            Notify("Config", "Config tersimpan ✅", 3)
        end
    end)
end)
Button("Config", "Load Config", function()
    pcall(function()
        if readfile and isfile and isfile("FiredX_VD.json") then
            local d = HttpService:JSONDecode(readfile("FiredX_VD.json"))
            for k, v in pairs(d) do VD[k] = v end
            Notify("Config", "Config dimuat ✅", 3)
        end
    end)
end)

