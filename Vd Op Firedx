                    local isK = IsKillerPlayer(p)
                    local show = (isK and VD.RADAR_ShowKiller) or (not isK and VD.RADAR_ShowSurvivor)
                    if show then
                        local pos = W2R(pr.Position)
                        if pos and di <= #radarDots then
                            local d = radarDots[di]
                            d.Size = UDim2.new(0, isK and 7 or 6, 0, isK and 7 or 6)
                            d.Position = UDim2.new(0, pos.X - (isK and 3.5 or 3), 0, pos.Y - (isK and 3.5 or 3))
                            d.BackgroundColor3 = isK and RADAR_COLORS.Killer or RADAR_COLORS.Survivor
                            d.Visible = true; di = di + 1
                        end
                    end
                end
            end
        end
    end
    local function AddObj(pos, color)
        if not pos or oi > #radarObjDots then return end
        local d = radarObjDots[oi]; d.Position = UDim2.new(0, pos.X - 2, 0, pos.Y - 2)
        d.BackgroundColor3 = color; d.Visible = true; oi = oi + 1
    end
    if VD.RADAR_ShowGenerator then
        for _, g in ipairs(KYS_Cache.Generators or {}) do
            if g.part and g.part.Parent then AddObj(W2R(g.part.Position), RADAR_COLORS.Generator) end
        end
    end
    if VD.RADAR_ShowHook then
        for _, h in ipairs(KYS_Cache.Hooks or {}) do
            if h.part and h.part.Parent then AddObj(W2R(h.part.Position), RADAR_COLORS.Hook) end
        end
    end
    if VD.RADAR_ShowGate then
        for _, g in ipairs(KYS_Cache.Gates or {}) do
            if g.part and g.part.Parent then AddObj(W2R(g.part.Position), RADAR_COLORS.Gate) end
        end
    end
end

