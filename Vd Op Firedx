        if not VD.RADAR_Enabled or not RadarGui then return end
        local cam = workspace.CurrentCamera
        local root = getRoot()
        if not cam or not root then return end
        local look = cam.CFrame.LookVector
        local angle = math.atan2(-look.X, -look.Z)
        local cosA, sinA = math.cos(angle), math.sin(angle)
        local halfSize = VD.RADAR_Size / 2
        local usableHalf = halfSize - 5
        local scale = usableHalf / VD.RADAR_Range
        for _, d in ipairs(dots) do d.Visible = false end
        local idx = 1
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character and idx <= #dots then
                local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local dx = hrp.Position.X - root.Position.X
                    local dz = hrp.Position.Z - root.Position.Z
                    local dist = math.sqrt(dx*dx + dz*dz)
                    if dist <= VD.RADAR_Range then
                        local rx = dx * cosA - dz * sinA
                        local rz = dx * sinA + dz * cosA
                        local px = math.clamp(rx * scale, -usableHalf + 4, usableHalf - 4)
                        local py = math.clamp(rz * scale, -usableHalf + 4, usableHalf - 4)
                        local dot = dots[idx]
                        dot.Position = UDim2.new(0, halfSize + px - 3, 0, halfSize + py - 3)
                        dot.BackgroundColor3 = (plr.Team and plr.Team.Name == "Killer") and Color3.fromRGB(255,0,0) or Color3.fromRGB(255,165,0)
                        dot.Visible = true
                        idx = idx + 1
                    end
                end
            end
        end
    end)
end

