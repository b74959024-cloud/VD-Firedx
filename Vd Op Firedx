        currentEmoteTrack = hum:LoadAnimation(anim); currentEmoteTrack.Looped = true; currentEmoteTrack:Play()
    end
    if data.Sound then
        currentEmoteSound = Instance.new("Sound"); currentEmoteSound.SoundId = data.Sound
        currentEmoteSound.Looped = true; currentEmoteSound.Volume = 2; currentEmoteSound.Parent = hrp
        currentEmoteSound:Play()
    end
end

