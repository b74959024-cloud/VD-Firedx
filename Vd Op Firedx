local AimState = { Target = nil, Holding = false }

local function GetClosestKiller(cam)
    if not cam then return nil end
    if GetRole() ~= "Survivor" then return nil end
    local myRoot = GetMyRoot(); if not myRoot then return nil end
    local cp, cd = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and IsKillerPlayer(p) and p.Character then
            local tr = p.Character:FindFirstChild("HumanoidRootPart")
            if tr then
                local dist = (tr.Position - myRoot.Position).Magnitude
                local passVis = true
                if VD.AIM_VisCheck then
                    local camPos = cam.CFrame.Position
                    local params = RaycastParams.new()
                    params.FilterType = Enum.RaycastFilterType.Blacklist
                    params.FilterDescendantsInstances = { cam, LocalPlayer.Character, p.Character }
                    passVis = (workspace:Raycast(camPos, tr.Position - camPos, params) == nil)
                end
                if passVis and dist < cd then cd = dist; cp = p end
            end
        end
    end
    return cp
end

local function UpdateAimbot(cam)
    if not VD.AIM_Enabled or GetRole() ~= "Survivor" then AimState.Target = nil; return end
    if VD.AIM_UseRMB and not AimState.Holding then AimState.Target = nil; return end
    local target = GetClosestKiller(cam)
    AimState.Target = target
    if target and target.Character then
        local tr = target.Character:FindFirstChild("HumanoidRootPart")
        if tr then
            local pos = tr.Position
            if VD.AIM_Predict then pos = pos + tr.AssemblyLinearVelocity * 0.1 end
            cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, pos), VD.AIM_Smooth or 0.3)
        end
    end
end

RunService.RenderStepped:Connect(function()
    local cam = workspace.CurrentCamera
    if cam and VD.AIM_Enabled then pcall(UpdateAimbot, cam) end
end)

