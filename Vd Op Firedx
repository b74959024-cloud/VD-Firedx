-- =====================================================
local GenBypass = {
    Cache = {},
    CacheTimer = 0,
    Processed = {},
}

local function GetGenerators()
    local now = tick()
    if now - GenBypass.CacheTimer < 5 then return GenBypass.Cache end
    GenBypass.Cache = {}
    GenBypass.CacheTimer = now
    local map = Workspace:FindFirstChild("Map")
    if not map then return GenBypass.Cache end
    pcall(function()
        for _, v in pairs(map:GetDescendants()) do
            if v:IsA("Model") and v.Name == "Generator" then
                if v:GetAttribute("RepairProgress") ~= nil or v:GetAttribute("kickcount") ~= nil then
                    table.insert(GenBypass.Cache, v)
                end
            end
        end
    end)
    return GenBypass.Cache
end

local function GetGenPoints(gen)
    local pts = {}
    pcall(function()
        for _, obj in pairs(gen:GetChildren()) do
            if obj.Name:find("GeneratorPoint") and obj:IsA("BasePart") then
                table.insert(pts, obj)
            end
        end
    end)
    return pts
end

local function WaitRepairing(pt, timeout)
    local t = tick()
    while tick() - t < (timeout or 1) do
        if pt:GetAttribute("IsRepairing") == true then return true end
        task.wait(0.05)
    end
    return false
end

local function DoRepair(targetPt)
    local gen = targetPt.Parent
    if GenBypass.Processed[gen] then return end
    GenBypass.Processed[gen] = true

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then GenBypass.Processed[gen] = nil; return end

    local RepairEvent = ReplicatedStorage:FindFirstChild("Remotes")
        and ReplicatedStorage.Remotes:FindFirstChild("Generator")
        and ReplicatedStorage.Remotes.Generator:FindFirstChild("RepairEvent")

    local origCF = hrp.CFrame
    pcall(function()
        for _, pt in pairs(GetGenPoints(gen)) do
            if pt ~= targetPt and pt.Parent then
                hrp.Anchored = true
                hrp.CFrame = pt.CFrame
                task.wait(0.15)
                pcall(function() if RepairEvent then RepairEvent:FireServer(pt, true) end end)
                if not WaitRepairing(pt, 0.8) then
                    pcall(function() if RepairEvent then RepairEvent:FireServer(pt, false) end end)
                    task.wait(0.1)
                    hrp.CFrame = pt.CFrame
                    task.wait(0.15)
                    pcall(function() if RepairEvent then RepairEvent:FireServer(pt, true) end end)
                    WaitRepairing(pt, 0.5)
                end
                hrp.Anchored = false
                task.wait(0.05)
            end
        end
    end)
    pcall(function()
        if hrp and hrp.Parent then
            hrp.Anchored = false
            hrp.CFrame = origCF
        end
    end)
    task.wait(0.1)
    pcall(function() if RepairEvent then RepairEvent:FireServer(targetPt, false) end end)
end

local function GetNearestGenPoint()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil, math.huge end
    local best, bestDist = nil, math.huge
    for _, gen in ipairs(GetGenerators()) do
        for _, pt in ipairs(GetGenPoints(gen)) do
            local d = (hrp.Position - pt.Position).Magnitude
            if d < bestDist then bestDist = d; best = pt end
        end
    end
    return best, bestDist
end

